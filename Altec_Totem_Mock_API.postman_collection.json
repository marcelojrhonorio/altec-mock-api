            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"catalog_invalidated\",\n  \"target\": {\n    \"tenant_id\": \"{{tenantId}}\",\n    \"kiosk_key\": \"{{tenantId}}|{{establishmentId}}|{{kioskId}}\"\n  },\n  \"payload\": {\n    \"reason\": \"manual_test\",\n    \"source\": \"postman\"\n  }\n}",
              "options": {
