            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evt-test-001\",\n  \"eventType\": \"CREATED\",\n  \"orderId\": \"{{orderId}}\",\n  \"createdAt\": \"2026-05-02T12:00:00.000Z\",\n  \"metadata\": {\n    \"order\": {\n      \"id\": \"{{orderId}}\",\n      \"type\": \"INDOOR\",\n      \"displayId\": \"PED-TEST\",\n      \"createdAt\": \"2026-05-02T12:00:00.000Z\",\n      \"orderTiming\": \"INSTANT\",\n      \"preparationStartDateTime\": \"2026-05-02T12:01:00.000Z\",\n      \"merchant\": {\n        \"id\": \"merch-001\",\n        \"name\": \"Test Store\"\n      },\n      \"items\": [\n        {\n          \"id\": \"item-001\",\n          \"name\": \"Pizza\",\n          \"unit\": \"UN\",\n          \"quantity\": 1,\n          \"unitPrice\": {\n            \"value\": 45.0,\n            \"currency\": \"BRL\"\n          },\n          \"totalPrice\": {\n            \"value\": 45.0,\n            \"currency\": \"BRL\"\n          },\n          \"externalCode\": \"prod-001\",\n          \"options\": []\n        }\n      ],\n      \"total\": {\n        \"itemsPrice\": {\n          \"value\": 45.0,\n          \"currency\": \"BRL\"\n        },\n        \"otherFees\": {\n          \"value\": 0.0,\n          \"currency\": \"BRL\"\n        },\n        \"discount\": {\n          \"value\": 0.0,\n          \"currency\": \"BRL\"\n        },\n        \"orderAmount\": {\n          \"value\": 45.0,\n          \"currency\": \"BRL\"\n        }\n      },\n      \"payments\": {\n        \"prepaid\": 45.0,\n        \"pending\": 0.0,\n        \"methods\": [\n          {\n            \"value\": 45.0,\n            \"currency\": \"BRL\",\n            \"type\": \"PREPAID\",\n            \"method\": \"PIX\"\n          }\n        ]\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orderUpdate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
